{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise.vinai.vn/contracts/model-profile.v1.schema.json",
  "title": "ModelProfile",
  "type": "object",
  "required": ["schemaVersion", "provider", "modelId", "capabilities", "contextLimits"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "provider": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "required": ["supportsTools", "supportsJsonSchema", "supportsStream", "supportsEmbeddings"],
      "properties": {
        "supportsTools": { "type": "boolean" },
        "supportsJsonSchema": { "type": "boolean" },
        "supportsStream": { "type": "boolean" },
        "supportsEmbeddings": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "contextLimits": {
      "type": "object",
      "required": ["contextWindow", "maxOutputTokens", "outputReserveMargin"],
      "properties": {
        "contextWindow": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "outputReserveMargin": { "type": "integer", "minimum": 0 },
        "maxInputTokens": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": ["object", "null"],
      "required": ["pricingVersion", "costPerPromptTokenUsd", "costPerCompletionTokenUsd"],
      "properties": {
        "pricingVersion": { "type": "string", "minLength": 1 },
        "costPerPromptTokenUsd": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,8})?$" },
        "costPerCompletionTokenUsd": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,8})?$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
