{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise.vinai.vn/contracts/model-embedding-response.v1.schema.json",
  "title": "ModelEmbeddingResponse",
  "type": "object",
  "required": [
    "requestId",
    "modelId",
    "dimensions",
    "count",
    "embeddings",
    "usage"
  ],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "modelId": { "type": "string", "minLength": 1 },
    "dimensions": { "type": "integer", "minimum": 1 },
    "count": { "type": "integer", "minimum": 1, "maximum": 32 },
    "embeddings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "array",
        "items": { "type": "number" }
      }
    },
    "usage": {
      "type": "object",
      "required": ["usageSource"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "usageSource": { "type": "string", "enum": ["provider", "estimated", "unknown"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
