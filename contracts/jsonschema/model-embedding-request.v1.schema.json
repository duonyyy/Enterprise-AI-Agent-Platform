{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise.vinai.vn/contracts/model-embedding-request.v1.schema.json",
  "title": "ModelEmbeddingRequest",
  "type": "object",
  "required": [
    "requestId",
    "tenantId",
    "workspaceId",
    "modelId",
    "inputs",
    "purpose"
  ],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "modelConfigId": { "type": ["string", "null"], "format": "uuid" },
    "modelId": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1 }
    },
    "purpose": { "type": "string", "enum": ["query", "passage"] }
  },
  "additionalProperties": false
}
