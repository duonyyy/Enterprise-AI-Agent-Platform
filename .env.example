# Platform Environment Configuration v1.0
ENV=development
LOG_LEVEL=info

# Database (PostgreSQL 16+ - DB-56)
# Host access URL (containers override host to internal DNS `postgres:5432`)
DATABASE_URL=postgresql+asyncpg://platform_app:${PLATFORM_APP_DB_PASSWORD}@127.0.0.1:5432/enterprise_agent_platform
REDIS_URL=redis://127.0.0.1:6379/0

# Vector DB (Qdrant - 384d Cosine for multilingual-e5-small)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# Real Embedding Model Snapshot (intfloat/multilingual-e5-small @ 614241f622f53c4eeff9890bdc4f31cfecc418b3)
# Point to the host directory whose final folder name is 614241f622f53c4eeff9890bdc4f31cfecc418b3
E5_MODEL_SNAPSHOT=./models/hub/models--intfloat--multilingual-e5-small/snapshots/614241f622f53c4eeff9890bdc4f31cfecc418b3

# Object Storage (MinIO / S3)
# S3_ACCESS_KEY must be a non-root application user (distinct from MINIO_ROOT_USER)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=replace-with-development-minio-access-key
S3_SECRET_KEY=replace-with-development-minio-secret-key
S3_BUCKET=agent-platform-docs

# Studio Web URLs (browser vs container-to-container internal DNS)
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_RUNTIME_API_URL=http://127.0.0.1:8001
CONTROL_API_INTERNAL_URL=http://control-api:8000
RUNTIME_API_URL=http://agent-runtime:8001

# Pluggable Event Bus (ADR-014: 'postgres_outbox' default; 'kafka' optional profile)
EVENT_BUS_TYPE=postgres_outbox
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=dev

# OpenTelemetry (optional; not enabled by default unless collector pipeline is configured)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Database & Infrastructure Secrets (placeholders only; never commit real secrets)
POSTGRES_PASSWORD=replace-with-a-secret-from-your-secret-manager
PLATFORM_APP_DB_PASSWORD=replace-with-a-secret-from-your-secret-manager
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ISSUER=http://localhost:8080/realms/enterprise
JWT_AUDIENCE=enterprise-control-api
RUNTIME_JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
RUNTIME_JWT_ISSUER=http://localhost:8080/realms/enterprise
RUNTIME_JWT_AUDIENCE=agent-runtime
MINIO_ROOT_USER=replace-with-development-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-development-minio-root-password

# Required only when enabling: docker compose --profile worker up
WORKER_TENANT_ID=
WORKER_WORKSPACE_ID=

# Placeholder OIDC Issuer (AU-01 Identity Provider selection remains an open architectural decision)
OIDC_ISSUER=http://localhost:8080/realms/enterprise
